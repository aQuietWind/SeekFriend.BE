gateway:
  self:
    block:
      ip-counts: 60
      id-counts: 180
      block-ip-request-header-name: X-Ip
    redis:
      key:
        name:
          ip-check: 
            name: "gateway:check:ip:"
            durationSeconds: 60
          id-check: 
            name: "gateway:check:id:"
            durationSeconds: 60
          ip-block: 
            name: "gateway:block:ip:"
            durationSeconds: 43200
          id-block: 
            name: "gateway:block:id:"
            durationSeconds: 86400
    request:
      path:
        allow-path:
        - /user/login
        - /user/login/opt
        - /user/login/password
        - /user/register
        - /user/register/opt
        - /admin/login
        - /admin/login/opt
        - /admin/login/password
        - /admin/register
        - /admin/register/opt
        reject-path:
        - /user/test/reject
    jvm-caffeine:
      ip-block:
        max-size: 100000
        expire-seconds: 600
      id-block:
        max-size: 100000
        expire-seconds: 600













