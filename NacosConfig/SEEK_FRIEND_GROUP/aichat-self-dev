  datasource:
    driver-class-name: org.postgresql.Driver
    # jdbc格式：jdbc:PostgreSQL://ip:端口/数据库名?参数
    url: jdbc:postgresql://127.0.0.1:5432/seek_friend_ai_chat?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: postgres
    password: 439176


aichat:
  self:
    params: 
      rules:
        record-description-max: 300
        record-store-max: 120
        initiative-interval-hours: 2
        record-file-dest: "D:/home/admin/seek_friend/aichat/record"
    redis:
      key:
        room-get-list-cooldown:
          name: "aichat:room:get:list:cooldown:"
          duration-seconds: 3
        room-inform-listen-cooldown:
          name: "aichat:room:inform:listen:cooldown:"
          duration-seconds: 3
        record-get-list-cooldown:
          name: "record:get:list:cooldown:"
          duration-seconds: 1
        record-insert-cooldown:
          name: "aichat:record:insert:cooldown:"
          duration-seconds: 3
        room-id-count:
          name: "aichat:room:id:count"
          duration-seconds: null
        record-id-count:
          name: "aichat:record:id:count"
          duration-seconds: null
        ai-friend-info-caffeine:
          name: "aichat:aifriend:info:caffeine:"
          duration-seconds: 600
    jvm-caffeine:
      ai-friend:
        max-size: 100000
        expire-time: 300






