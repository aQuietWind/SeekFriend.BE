common:
  jwt:
    user:
      secret-key: 1234567890123456789012345678901234567890123456789012
      header-sign: "1"
      #这是七天有效期的毫秒值
      token-duration: 604800000
    global:
      token-header-separator: "-"
      request-header-token-name: Token-Id
      request-header-token-id-name: access_token
      max-store: 3