<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seek.friend.aichat.Mapper.RoomMapper">

    <!-- 全局统一字段映射 -->
    <resultMap id="AiChatRoomResultMap" type="com.seek.friend.serviceobject.AiChat.ChatRoomDTO">
    </resultMap>



    <insert id="insert">
        insert into "chat_room"
        (ai_friend_id,user_id)
        values(#{aiFriendId},#{userId});
    </insert>

    <select id="getList" resultMap="AiChatRoomResultMap">
        select
        ai_friend_id,
        user_id,
        lastest_chat_time,
        create_time,
        able_chat
        from "chat_room"
        where user_id=#{userId} and able_chat=true
        limit #{need} offset #{start}
    </select>

    <update id="delete">
        update "chat_room"
        set able_chat=false
        where ai_friend_id=#{aiFriendId}
    </update>

    <update id="syncLastestChatTime">
        update "chat_room"
        set lastest_chat_time=CURRENT_TIMESTAMP
        where ai_friend_id=#{aiFriendId}
    </update>

    <select id="exist" resultType="java.lang.Boolean">
        select exists(select 1
        from "chat_room"
        where ai_friend_id=#{aiFriendId} and user_id=#{userId}
        and able_chat=true)
    </select>
</mapper>